# Dremio Cloud Configuration
# These variables are used to configure the 'cloud' profile for testing against Dremio Cloud.
DREMIO_CLOUD_TYPE=cloud
DREMIO_CLOUD_BASE_URL=https://api.dremio.cloud/v0
DREMIO_CLOUD_PROJECTID=your_project_id_here
DREMIO_CLOUD_TOKEN=your_cloud_auth_token_here
DREMIO_CLOUD_TEST_FOLDER=@your_user  # Defaults to @user if not set. Used for creating test folders.

# Dremio Software Configuration
# These variables are used to configure the 'software' profile for testing against Dremio Software.
DREMIO_SOFTWARE_TYPE=software
DREMIO_SOFTWARE_BASE_URL=http://localhost:9047/api/v3  # Adjust URL/port as needed
DREMIO_SOFTWARE_TOKEN=your_software_pat_here # If using PAT authentication
# OR
# DREMIO_SOFTWARE_USERNAME=your_username
# DREMIO_SOFTWARE_PASSWORD=your_password
DREMIO_SOFTWARE_TEST_FOLDER=dremio-catalog.home # Defaults to dremio-catalog.home if not set
